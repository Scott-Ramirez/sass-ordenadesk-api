# Puerto de escucha (Render lo asigna automáticamente si no se define)
PORT=3000
NODE_ENV=production

# URLs de conexión de Postgres / Supabase
DATABASE_URL="postgresql://usuario:contraseña@servidor.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://usuario:contraseña@servidor.com:5432/postgres"

# Orígenes permitidos para CORS (separados por coma o vacío para permitir todos)
ALLOWED_ORIGINS="http://localhost:3000,https://ordenadesk.app"
